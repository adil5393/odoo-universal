<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_summary_bill_wizard_form" model="ir.ui.view">
        <field name="name">purchase.summary.bill.wizard.form</field>
        <field name="model">purchase.summary.bill.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Summary Bill">
                <group>
                    <field name="order_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="name"/>
                    <field name="amount"/>
                    <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_create_bill" type="object" class="btn-primary"
                            string="Create Bill"/>
                    <button special="cancel" string="Discard"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
