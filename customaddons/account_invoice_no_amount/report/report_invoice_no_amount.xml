<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_invoice_no_amount_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <div class="row">
                    <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                        <div class="col-6">
                            <div groups="account.group_delivery_invoice_address" name="shipping_address_block">
                                <strong>Shipping Address:</strong>
                                <div t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            </div>
                        </div>
                        <div class="col-6" name="address_not_same_as_shipping">
                            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="offset-col-6 col-6" name="no_shipping">
                            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                        </div>
                    </t>
                </div>
                <div class="mt-5 clearfix">
                    <div class="page mb-4">
                        <h2>
                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                            <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span>
                            <span t-elif="o.move_type == 'out_invoice'">Invoice</span>
                            <span t-elif="o.move_type == 'out_refund'">Credit Note</span>
                            <span t-else="">Document</span>
                            <small class="text-muted"> (No Amount)</small>
                            <span t-if="o.name != '/'" t-field="o.name">INV/2023/0001</span>
                        </h2>
                        <div class="oe_structure"></div>
                        <div id="informations" class="row mt-3 mb-1">
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">
                                <strong>Date:</strong><br/>
                                <span t-field="o.invoice_date">2023-09-12</span>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.delivery_date" name="delivery_date">
                                <strong>Delivery Date:</strong><br/>
                                <span t-field="o.delivery_date">2023-09-25</span>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_origin" name="origin">
                                <strong>Source:</strong><br/>
                                <span t-field="o.invoice_origin">SO123</span>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.ref" name="reference">
                                <strong>Reference:</strong><br/>
                                <span t-field="o.ref">INV/2023/00001</span>
                            </div>
                        </div>

                        <div class="oe_structure"></div>
                        <table class="table table-sm o_main_table table-borderless" name="invoice_line_table">
                            <thead>
                                <tr>
                                    <th name="th_description" class="text-start"><span>Description</span></th>
                                    <th name="th_quantity" class="text-end"><span>Quantity</span></th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                                <t t-foreach="lines" t-as="line">
                                    <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                        <t t-if="line.display_type == 'product'">
                                            <td name="account_invoice_line_name"><span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Bacon Burger</span></td>
                                            <td name="td_quantity" class="text-end">
                                                <span t-field="line.quantity">3.00</span>
                                                <span t-field="line.product_uom_id" groups="uom.group_uom">units</span>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_section'">
                                            <td colspan="99">
                                                <span t-field="line.name" t-options="{'widget': 'text'}">A section title</span>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_note'">
                                            <td colspan="99">
                                                <span t-field="line.name" t-options="{'widget': 'text'}">A note</span>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <template id="report_invoice_no_amount">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-call="account_invoice_no_amount.report_invoice_no_amount_document" t-lang="lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
