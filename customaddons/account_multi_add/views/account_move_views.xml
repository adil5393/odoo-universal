<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_multi_add" model="ir.ui.view">
        <field name="name">account.move.form.multi.add</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post'][1]" position="before">
                <button name="action_open_multi_add"
                        type="object"
                        string="Add Multiple Products"
                        class="btn-secondary"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>

</odoo>
