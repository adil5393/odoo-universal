<odoo>
  <record id="view_account_payment_register_pos_qr" model="ir.ui.view">
    <field name="name">account.payment.register.pos.qr</field><field name="model">account.payment.register</field>
    <field name="inherit_id" ref="account.view_account_payment_register_form"/>
    <field name="arch" type="xml">
      <xpath expr="//footer/button[@name='action_create_payments'][1]" position="before">
        <button name="action_create_pos_qr" string="Create QR for POS" type="object" class="btn-secondary" groups="account.group_account_invoice"/>
      </xpath>
    </field>
  </record>
</odoo>
